# Local Backend
LOCAL_BACKEND_PORT=8765
DEBUG_LOGGING_ENABLED=false        # CP1/CP4 raw-PII logging — off by default, see docs/architecture.md 1.4
VAULT_EXPIRY_HOURS=24

# Cloud Backend
CLOUD_BACKEND_PORT=8000
CLOUD_AUDIT_MODE=metadata_only     # metadata_only | full_text (enterprise opt-in only)
DATABASE_URL=sqlite:///./cloud_backend.db

# Extension <-> Local Backend handshake
# Per-install shared-secret token is generated at runtime, NOT stored here.
