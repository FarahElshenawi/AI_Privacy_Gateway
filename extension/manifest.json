{
  "manifest_version": 3,
  "name": "Doppel \u2014 AI Privacy Gateway",
  "version": "2.2.0",
  "description": "Masks sensitive PII before it reaches ChatGPT and Gemini. Uses chrome.debugger + CDP for network-layer interception.",
  "permissions": [
    "activeTab",
    "alarms",
    "debugger",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.blob.core.windows.net/*",
    "https://gemini.google.com/*",
    "https://content-push.googleapis.com/*",
    "https://push.clients6.google.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Doppel \u2014 AI Privacy Gateway"
  },
  "icons": {}
}
