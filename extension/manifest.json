{
  "manifest_version": 3,
  "name": "Doppel — AI Privacy Gateway",
  "version": "2.0.0",
  "description": "Masks sensitive PII before it reaches LLMs. Uses chrome.debugger + CDP for network-layer interception — no MAIN-world fetch hacks.",
  "permissions": ["debugger", "storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.blob.core.windows.net/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Doppel — AI Privacy Gateway"
  },
  "icons": {}
}
