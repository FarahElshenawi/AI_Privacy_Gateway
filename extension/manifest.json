{
  "manifest_version": 3,
  "name": "AI Privacy Gateway",
  "version": "0.1.0",
  "description": "Masks sensitive data before it reaches public LLM web UIs.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*", "http://localhost:8765/*"],
  "background": { "service_worker": "src/background/service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/content/inject.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "src/popup/popup.html" }
}
