# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- Node ---
node_modules/
dist/
build/
.vite/

# --- Env / secrets ---
.env
.env.*
!.env.example
*.local

# --- Model artifacts (fetched via scripts/fetch_models.sh, not committed) ---
local-backend/models/*.onnx
local-backend/models/*.bin

# --- Local data / logs (never commit real or synthetic PII checkpoint DBs) ---
local-backend/**/*.sqlite3
local-backend/**/debug_logs/
cloud-backend/**/*.sqlite3

# --- Eval reports (generated, not source) ---
eval/reports/*
!eval/reports/.gitkeep

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
cloud-backend/**/*.db
cloud-backend/**/*.db
*.db
local-backend/eval/eval_set_v2.jsonl
local-backend/eval/*

local-backend/models/*.onnx
local-backend/models/*.onnx.data

next/
# --- Next.js / local DBs ---
.next/
website/.next/
cloud-backend/*.db

# --- Evaluation: source and the hold-out's sha256 are committed (local-backend/dlp_core/eval/holdout_v1.sha256).
# The hold-out file itself is regenerated deterministically (python -m dlp_core.eval.make_holdout) and checked
# against that hash: its synthetic fake secrets trip GitHub push protection, so the .jsonl stays untracked. ---
local-backend/dlp_core/eval/out/
local-backend/dlp_core/eval/__pycache__/

# --- Secrets: never commit signing keys or certificates ---
*.pem
*.key
*.p12
