<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.doppel.backend</string>
  <key>WorkingDirectory</key><string>@APP@/app</string>
  <key>ProgramArguments</key><array>
    <string>@APP@/venv/bin/uvicorn</string><string>app.main:app</string>
    <string>--host</string><string>127.0.0.1</string><string>--port</string><string>8765</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>DLP_TIER2_MODEL</key><string>@APP@/model</string>
    <key>DLP_EXTENSION_IDS</key><string>@EXT_IDS@</string>
    <key>CLOUD_URL</key><string>@CLOUD_URL@</string>
    <key>CLOUD_ENROLL_KEY</key><string>@ENROLL@</string>
    <key>HF_HUB_OFFLINE</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>@APP@/backend.log</string>
</dict></plist>
